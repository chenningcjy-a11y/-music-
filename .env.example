# LUMINA MUSIC 环境变量模板
# 注意：切勿将真实 API Key 提交到 Git 仓库。在生产环境请于平台控制台设置环境变量，
# 或直接在应用内「设置 → AI 智能中心 → API 服务管理」中动态填写（密钥仅经服务端加密代理）。

# 本地 Express 服务监听端口（默认 3000）
PORT=3000

# 可选：服务端全局密钥加密主密钥（建议在 Netlify 环境变量中配置任意 32 位以上随机字符串）
LUMINA_VAULT_SECRET=

# 可选：服务端默认兜底或预配置 AI 服务商密钥（均为服务端私有变量，切勿使用 VITE_ 前缀）
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
